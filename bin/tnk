#!/bin/bash
# tnk — create new tmux session, start Kiro inside it, and sync VS Code tasks.
# Usage: tnk <session-name>

if [ -z "${1:-}" ] || [[ "$1" == -* ]]; then
  echo "Usage: tnk <session-name>"
  exit 1
fi

NAME="$1"
SCRIPTS="${VSCODECONFIG_SCRIPTS_DIR:-$(cd "$(dirname "$(readlink -f "$0")")/../scripts" && pwd)}"

if tmux has-session -t "=$NAME" 2>/dev/null; then
  echo "Session '$NAME' already exists — use: ta $NAME"
  exit 1
fi

tmux new-session -d -s "$NAME" || { echo "tmux new-session failed"; exit 1; }
tmux send-keys -t "$NAME" "kiro-cli chat -a" Enter

( bash "$SCRIPTS/sync-state.sh" >/dev/null 2>&1 & )

printf '\033]0;%s\007' "$NAME"
tmux attach -t "$NAME"
